2
---
const testimonials = [
  {
    quote:
      "Add a verified student testimonial describing their experience with Rey Tutoring, the personalized instruction they received, and how it helped them prepare for the LSAT.",
    name: "Student Name",
    detail: "LSAT Student",
    score: "Add verified score improvement",
    initials: "S",
  },
  {
    quote:
      "Add a verified testimonial highlighting the tutoring approach, improvements in understanding difficult concepts, and the student's overall experience.",
    name: "Student Name",
    detail: "LSAT Student",
    score: "Add verified score improvement",
    initials: "S",
  },
  {
    quote:
      "Add a verified testimonial discussing the student's preparation journey, accountability, and experience working with Rey Tutoring.",
    name: "Student Name",
    detail: "LSAT Student",
    score: "Add verified score improvement",
    initials: "S",
  },
];
---

<section id="testimonials" class="bg-rey-ivory py-20 md:py-28">

  <div class="mx-auto max-w-7xl px-6 lg:px-10">

    <!-- Section Heading -->
    <div class="mx-auto mb-14 max-w-3xl text-center">

      <div class="mb-4 flex items-center justify-center gap-3">
        <div class="h-px w-10 bg-rey-gold"></div>

        <span class="text-sm font-bold uppercase tracking-[0.2em] text-rey-gold">
          Student Experiences
        </span>

        <div class="h-px w-10 bg-rey-gold"></div>
      </div>

      <h2 class="section-title">
        Success Starts With the Right Guidance.
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-rey-charcoal/75">
        Every student's journey is different. Discover how personalized
        preparation, thoughtful instruction, and consistent support can
        make a difference.
      </p>

    </div>

    <!-- Testimonial Cards -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

      {testimonials.map((testimonial) => (
        <article class="testimonial-card flex flex-col">

          <!-- Quote Icon -->
          <div class="mb-6 flex items-center justify-between">

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 40 40"
              fill="currentColor"
              class="h-10 w-10 text-rey-gold/80"
              aria-hidden="true"
            >
              <path d="M8 10h10v10c0 7-4 11-10 13v-5c3-1 5-3 5-6H8V10Zm15 0h10v10c0 7-4 11-10 13v-5c3-1 5-3 5-6h-5V10Z" />
            </svg>

            <span class="rounded-full bg-rey-champagne px-3 py-1 text-xs font-semibold uppercase tracking-wider text-rey-navy">
              Student Review
            </span>

          </div>

          <!-- Testimonial -->
          <blockquote class="flex-1 text-base leading-7 text-rey-charcoal/80">
            "{testimonial.quote}"
          </blockquote>

          <!-- Divider -->
          <div class="my-7 h-px bg-rey-champagne"></div>

          <!-- Student Information -->
          <div class="flex items-center gap-4">

            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-rey-navy font-heading text-xl font-semibold text-white">
              {testimonial.initials}
            </div>

            <div class="min-w-0">
              <h3 class="font-semibold text-rey-navy">
                {testimonial.name}
              </h3>

              <p class="mt-1 text-sm text-rey-charcoal/60">
                {testimonial.detail}
              </p>
            </div>

          </div>

          <!-- Score Improvement -->
          <div class="mt-5 rounded-sm bg-rey-ivory px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-rey-gold">
              Student Results
            </p>

            <p class="mt-1 text-sm font-medium text-rey-navy">
              {testimonial.score}
            </p>
          </div>

        </article>
      ))}

    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 flex flex-col items-center justify-between gap-6 rounded-sm bg-rey-navy px-8 py-10 text-center md:flex-row md:px-12 md:text-left">

      <div>
        <h3 class="font-heading text-3xl font-semibold text-white md:text-4xl">
          Your LSAT Journey Starts Here.
        </h3>

        <p class="mt-2 text-white/75">
          Let's build a preparation plan around your goals.
        </p>
      </div>

      <a
        href="#contact"
        class="secondary-button shrink-0 border-rey-gold bg-rey-gold text-rey-navy hover:bg-rey-ivory hover:text-rey-navy"
      >
        Schedule a Free Session

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M5 12h14m-7-7 7 7-7 7" />
        </svg>
      </a>

    </div>

  </div>
</section>

<style>
  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-rey-navy);
  }

  .testimonial-card {
    border: 1px solid var(--color-rey-champagne);
    border-radius: 4px;
    background-color: white;
    padding: 28px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgb(16 36 72 / 8%);
  }

  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid var(--color-rey-gold);
    border-radius: 5px;
    padding: 14px 22px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    transition: all 0.2s ease;
  }
</style>
