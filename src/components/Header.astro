
---
const navigation = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Testimonials", href: "#testimonials" },
  { label: "Resources", href: "#resources" },
  { label: "Contact", href: "#contact" },
];

import logo from '../assets/LargeLogo.png';
---

<header class="relative z-50 bg-rey-ivory">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">

    <!-- Logo -->
    <a href="/" aria-label="Rey Tutoring home">
      <img
        src={logo.src}
        alt="Rey Tutoring"
        class="w-32 md:w-40"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-6 lg:flex xl:gap-8"
      aria-label="Main navigation"
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link",
            item.label === "Home" && "active",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a href="#contact" class="primary-button hidden sm:inline-flex">
      Book a Free Session

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path d="M5 12h14m-7-7 7 7-7 7" />
      </svg>
    </a>

    <!-- Mobile Navigation -->
    <details class="mobile-menu relative lg:hidden">

      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-rey-champagne text-rey-navy transition hover:bg-rey-champagne [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger Icon -->
        <svg
          class="menu-open h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <!-- Close Icon -->
        <svg
          class="menu-close hidden h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="m18 6-12 12M6 6l12 12" />
        </svg>
      </summary>

      <!-- Dropdown -->
      <nav
        class="absolute right-0 top-14 z-50 w-64 rounded-md border border-rey-champagne bg-rey-ivory p-5 shadow-xl"
        aria-label="Mobile navigation"
      >
        <div class="flex flex-col gap-1">

          {navigation.map((item) => (
            <a
              href={item.href}
              class="mobile-nav-link"
            >
              {item.label}
            </a>
          ))}

        </div>

        <div class="mt-4 border-t border-rey-champagne pt-4">
          <a href="#contact" class="primary-button w-full">
            Book a Free Session
          </a>
        </div>
      </nav>
    </details>

  </div>
</header>

<style>
  .nav-link {
    position: relative;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-rey-charcoal);
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-rey-navy);
  }

  .nav-link.active::after {
    position: absolute;
    bottom: -12px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-rey-gold);
    content: "";
  }

  .mobile-nav-link {
    display: block;
    border-radius: 4px;
    padding: 11px 12px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-rey-charcoal);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-rey-champagne);
    color: var(--color-rey-navy);
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid var(--color-rey-navy);
    border-radius: 5px;
    background-color: var(--color-rey-navy);
    padding: 13px 20px;
    color: white;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .primary-button:hover {
    background-color: var(--color-rey-charcoal);
    border-color: var(--color-rey-charcoal);
  }

  .mobile-menu[open] .menu-open {
    display: none;
  }

  .mobile-menu[open] .menu-close {
    display: block;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
</style>
